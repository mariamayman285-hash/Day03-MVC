@model Department
@{
	ViewData["Title"] = "Data";
}

<form method="post" action="/Department/SaveAdd" >

	<div>
		<label>Name</label>
		<input type="text" name="Name" id="Name" value="@Model?.Name" class="form form-control"/>
	</div>

	<div>
		<label>Manager Name</label>
		<input type="text" name="MgrName" id="MgrName" value="@Model?.MgrName" class="form form-control"/>
	</div>

	<input type="Submit" value="create" class="btn btn-primary mt-4 mb-4"/>

</form>


@* the return to table button *@
<a href="/Department/Index">
	Back to list page
</a>